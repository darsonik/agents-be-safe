# Set these as environment variables before starting; .env is not auto-loaded.
FIREWORKS_API_KEY=
# Use the exact model/deployment ID from your Fireworks account; JSON mode required.
FIREWORKS_MODEL=
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Optional GitHub token for a higher read rate limit. Public repositories only.
GITHUB_TOKEN=
PORT=8000
